# Cloudflare Access
ALLOWED_EMAIL=your-email@example.com
ACCESS_AUDIENCE=<your-access-audience-tag>
# https:// は不要。例：your-team.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com

# ローカル開発用: このメールで認証をスキップして API を利用する（本番では設定しない）
DEV_USER_EMAIL=your-email@example.com

# Local D1 (optional)
DB_URL=./.data/my-todo.db
