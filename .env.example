# Cloudflare Access（本番・ローカル共通。NUXT_ プレフィックス必須）
NUXT_ALLOWED_EMAIL=your-email@example.com
NUXT_ACCESS_AUDIENCE=<your-access-audience-tag>
# https:// は不要。例：your-team.cloudflareaccess.com
NUXT_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com

# ローカル開発用: このメールで認証をスキップして API を利用する（本番では設定しない）
NUXT_DEV_USER_EMAIL=your-email@example.com

# Local D1 (optional)
DB_URL=./.data/my-todo.db
