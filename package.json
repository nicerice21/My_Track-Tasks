{
  "name": "my-todo",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "build:cloudflare": "nuxt build --preset=cloudflare_module",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply my-todo-db",
    "db:migrate:local": "wrangler d1 migrations apply my-todo-db --local",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.10.1",
    "drizzle-orm": "^0.41.0",
    "jose": "^6.0.10",
    "nuxt": "^3.21.11",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@nuxtjs/tailwindcss": "^6.13.2",
    "@types/node": "^26.6.6",
    "autoprefixer": "^10.4.21",
    "daisyui": "^4.12.24",
    "drizzle-kit": "^0.30.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.7.0"
  }
}
